# Server settings for the hosted Diocle. Copy to diocle.env on the server (never commit it) and fill in.

# Hosted mode: read-only for visitors; starting a delivery needs DIOCLE_ADMIN_TOKEN (a long random passcode).
DIOCLE_HOSTED=1
DIOCLE_ADMIN_TOKEN=
DIOCLE_WEB_ORIGINS=https://your-domain.example

# Meta models (same as the repo's .env)
META_MODEL_API_KEY=
META_MODEL_BASE_URL=https://api.meta.ai/v1
META_MODEL_ID=muse-spark-1.3-contributor
OPEN_MODEL_API_KEY=
OPEN_MODEL_BASE_URL=https://api.fireworks.ai/inference/v1
OPEN_MODEL_ID=accounts/fireworks/models/muse-spark-open
MODEL_MODE=hosted
MODEL_REASONING_EFFORT=medium

# Cost caps (rule 10)
MODEL_MAX_CALLS_PER_RUN=60
MODEL_MAX_CALLS_PER_ROUND=20
MODEL_MAX_ROUNDS=3
MODEL_MAX_ATTACK_ROUNDS=3
MODEL_MAX_BREAKER_CYCLES=1
DIOCLE_MAX_PARALLEL=2
DIOCLE_MAX_PROGRAMS=10

# Only these GitHub owners may be imported from or delivered to.
DIOCLE_IMPORT_OWNERS=Nivetha200111
# A fine-grained GitHub token with Contents and Pull requests (read and write) on the target repositories only.
GH_TOKEN=
