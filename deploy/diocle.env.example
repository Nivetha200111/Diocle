# Server settings for the hosted Diocle. Copy to diocle.env on the server (never commit it) and fill in.

# Hosted mode: read-only for visitors; starting a delivery needs DIOCLE_ADMIN_TOKEN (a long random passcode).
DIOCLE_HOSTED=1
DIOCLE_ADMIN_TOKEN=
DIOCLE_WEB_ORIGINS=https://your-domain.example

# Meta models (same as the repo's .env)
META_MODEL_API_KEY=
META_MODEL_BASE_URL=https://api.meta.ai/v1
META_MODEL_ID=muse-spark-1.3-contributor
OPEN_MODEL_API_KEY=
OPEN_MODEL_BASE_URL=https://api.fireworks.ai/inference/v1
OPEN_MODEL_ID=accounts/fireworks/models/muse-spark-open
MODEL_MODE=hosted
MODEL_REASONING_EFFORT=medium

# Guard agent (in progress): reviews each certified run's final Java against the COBOL with its own Meta model and
# key, and can revoke certification. Its deterministic policy runs on every run regardless. Leave empty for policy only.
# Muse Spark Open on Baseten (same price as Fireworks: $1.25 in / $0.15 cached / $4.25 out per 1M tokens).
GUARD_MODEL_API_KEY=
GUARD_MODEL_BASE_URL=https://inference.baseten.co/v1
GUARD_MODEL_ID=meta-models/muse-spark-open-1026
GUARD_REASONING_EFFORT=medium
# Hard cap (rule 10): model calls the guard may make per run
GUARD_MAX_CALLS=2
# Independent cross-check (CLI --crosscheck only): uses OPEN_MODEL_* unless CROSSCHECK_MODEL_* is set. Hard cap (rule 10):
# CROSSCHECK_MAX_CALLS=2

# Cost caps (rule 10)
MODEL_MAX_CALLS_PER_RUN=60
MODEL_MAX_CALLS_PER_ROUND=20
MODEL_MAX_ROUNDS=3
MODEL_MAX_ATTACK_ROUNDS=3
MODEL_MAX_BREAKER_CYCLES=1
DIOCLE_MAX_PARALLEL=2
DIOCLE_MAX_PROGRAMS=10

# Visitor imports: anyone may import a public GitHub repository without the passcode. Needs the sandbox
# (docker-compose.api.yml sets DIOCLE_SANDBOX_URL). Results stay on the site; no pull request is opened.
DIOCLE_PUBLIC_IMPORTS=1
DIOCLE_PUBLIC_DAILY_USD=2
DIOCLE_PUBLIC_PER_VISITOR=3
DIOCLE_PUBLIC_MAX_PROGRAMS=3
DIOCLE_PUBLIC_MAX_LINES=1500

# Only these GitHub owners may be imported from or delivered to with the passcode.
DIOCLE_IMPORT_OWNERS=Nivetha200111
# A fine-grained GitHub token with Contents and Pull requests (read and write) on the target repositories only.
GH_TOKEN=
