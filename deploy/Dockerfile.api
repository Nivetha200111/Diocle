# Diocle API and pipeline: GnuCOBOL 3.2 (the oracle), JDK 21, and the Python services.
# The services keep their own virtualenvs at the same paths as in development, because the API
# starts the converter, analyzer and verifier by those paths.
FROM ubuntu:24.04 AS gnucobol
RUN apt-get update -q && apt-get install -y -q --no-install-recommends build-essential curl ca-certificates libgmp-dev xz-utils \
 && rm -rf /var/lib/apt/lists/*
RUN curl -sSfL https://ftp.gnu.org/gnu/gnucobol/gnucobol-3.2.tar.xz | tar xJ -C /tmp \
 && cd /tmp/gnucobol-3.2 \
 && ./configure -q --prefix=/opt/gnucobol --without-db --with-curses=no --without-xml2 --without-json \
 && make -s -j"$(nproc)" && make -s install

FROM ubuntu:24.04
RUN apt-get update -q && apt-get install -y -q --no-install-recommends \
      openjdk-21-jdk-headless python3 python3-venv git gh ca-certificates libgmp-dev gcc libc6-dev libsqlite3-dev curl \
 && rm -rf /var/lib/apt/lists/*
# Stand-in database for the EXEC SQL verifier (SQLite, NOT DB2): libsqlite3-dev above is linked into the COBOL side by a C shim;
# the Java side uses the org.xerial JDBC driver (Apache-2.0). Fetched at BUILD time only (the sandbox has no network at run time).
# BEFORE DEPLOY: the version below was written from memory and never fetched; confirm it exists and set SQLITE_JDBC_SHA256 (the build
# fails closed if the download or the checksum is wrong). Pin SQLITE_JDBC_SHA256 once you have checked the hash printed in the build log; without it the build checks the jar against
# the checksum Maven Central publishes next to it (integrity of the download, not an independent pin).
ARG SQLITE_JDBC_VERSION=3.46.1.3
ARG SQLITE_JDBC_SHA256=
RUN mkdir -p /opt/diocle/lib \
 && base=https://repo1.maven.org/maven2/org/xerial/sqlite-jdbc/${SQLITE_JDBC_VERSION} \
 && curl -sSfL -o /opt/diocle/lib/sqlite-jdbc.jar ${base}/sqlite-jdbc-${SQLITE_JDBC_VERSION}.jar \
 && want="${SQLITE_JDBC_SHA256:-$(curl -sSfL ${base}/sqlite-jdbc-${SQLITE_JDBC_VERSION}.jar.sha256 | cut -d' ' -f1)}" \
 && echo "${want}  /opt/diocle/lib/sqlite-jdbc.jar" | sha256sum -c - && echo "sqlite-jdbc sha256: ${want}" \
 && chmod 0644 /opt/diocle/lib/sqlite-jdbc.jar
COPY --from=gnucobol /opt/gnucobol /opt/gnucobol
ENV PATH=/opt/gnucobol/bin:$PATH LD_LIBRARY_PATH=/opt/gnucobol/lib PYTHONUNBUFFERED=1

RUN useradd --create-home --uid 10001 diocle
WORKDIR /srv/diocle
COPY --chown=diocle:diocle contracts contracts
COPY --chown=diocle:diocle services services
COPY --chown=diocle:diocle skills skills
# Synthetic samples, so runs certified on them can be re-verified by visitors.
COPY --chown=diocle:diocle samples samples
COPY --chown=diocle:diocle eval/samples eval/samples
RUN rm -rf services/*/.venv \
 && for s in analyzer verifier; do python3 -m venv services/$s/.venv && services/$s/.venv/bin/pip install -q -e services/analyzer -e services/verifier; done \
 && python3 -m venv services/converter/.venv && services/converter/.venv/bin/pip install -q -e services/analyzer -e services/verifier -e services/converter \
 && python3 -m venv services/api/.venv && services/api/.venv/bin/pip install -q -e services/api \
 && chown -R diocle:diocle services
COPY --chown=diocle:diocle deploy/entrypoint.sh /usr/local/bin/diocle-entrypoint
RUN mkdir -p /srv/diocle/runs && chown diocle:diocle /srv/diocle/runs
USER diocle
# Runs, deliveries and fix memory live on a volume so they survive rebuilds.
VOLUME /srv/diocle/runs
EXPOSE 8000
ENTRYPOINT ["/usr/local/bin/diocle-entrypoint"]
