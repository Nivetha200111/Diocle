# Diocle API and pipeline: GnuCOBOL 3.2 (the oracle), JDK 21, and the Python services.
# The services keep their own virtualenvs at the same paths as in development, because the API
# starts the converter, analyzer and verifier by those paths.
FROM ubuntu:24.04 AS gnucobol
RUN apt-get update -q && apt-get install -y -q --no-install-recommends build-essential curl ca-certificates libgmp-dev xz-utils \
 && rm -rf /var/lib/apt/lists/*
RUN curl -sSfL https://ftp.gnu.org/gnu/gnucobol/gnucobol-3.2.tar.xz | tar xJ -C /tmp \
 && cd /tmp/gnucobol-3.2 \
 && ./configure -q --prefix=/opt/gnucobol --without-db --with-curses=no --without-xml2 --without-json \
 && make -s -j"$(nproc)" && make -s install

FROM ubuntu:24.04
RUN apt-get update -q && apt-get install -y -q --no-install-recommends \
      openjdk-21-jdk-headless python3 python3-venv git gh ca-certificates libgmp-dev gcc libc6-dev \
 && rm -rf /var/lib/apt/lists/*
COPY --from=gnucobol /opt/gnucobol /opt/gnucobol
ENV PATH=/opt/gnucobol/bin:$PATH LD_LIBRARY_PATH=/opt/gnucobol/lib PYTHONUNBUFFERED=1

RUN useradd --create-home --uid 10001 diocle
WORKDIR /srv/diocle
COPY --chown=diocle:diocle contracts contracts
COPY --chown=diocle:diocle services services
COPY --chown=diocle:diocle skills skills
RUN rm -rf services/*/.venv \
 && for s in analyzer verifier; do python3 -m venv services/$s/.venv && services/$s/.venv/bin/pip install -q -e services/analyzer -e services/verifier; done \
 && python3 -m venv services/converter/.venv && services/converter/.venv/bin/pip install -q -e services/analyzer -e services/verifier -e services/converter \
 && python3 -m venv services/api/.venv && services/api/.venv/bin/pip install -q -e services/api \
 && chown -R diocle:diocle services
COPY --chown=diocle:diocle deploy/entrypoint.sh /usr/local/bin/diocle-entrypoint
RUN mkdir -p /srv/diocle/runs /srv/diocle/work && chown diocle:diocle /srv/diocle/runs /srv/diocle/work
USER diocle
# Runs, deliveries and fix memory live on a volume so they survive rebuilds; work is shared with the sandbox.
VOLUME /srv/diocle/runs
EXPOSE 8000
ENTRYPOINT ["/usr/local/bin/diocle-entrypoint"]
