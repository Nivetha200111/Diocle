# DIOCLE_DOMAIN is the public domain (Caddy gets and renews its HTTPS certificate). Use "localhost" to test.
{$DIOCLE_DOMAIN:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'"
		-Server
	}

	handle_path /api/* {
		# Small everywhere except the two capped uploads. The API also counts the bytes it reads.
		@audio path /asks/upload
		request_body @audio {
			max_size 1MB
		}
		@image path /samples/live/upload
		request_body @image {
			max_size 3MB
		}
		@rest not path /asks/upload /samples/live/upload
		request_body @rest {
			max_size 16KB
		}
		reverse_proxy api:8000
	}

	handle {
		root * /srv/www
		try_files {path} {path}.html /index.html
		file_server
	}
}
