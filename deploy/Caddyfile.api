# Engine server: HTTPS for api.<domain>, forwarding to the API container. The site itself is on Vercel,
# which forwards /api/* here. DIOCLE_API_DOMAIN is e.g. api.example.com.
{$DIOCLE_API_DOMAIN:localhost} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}
	# Small everywhere except the two capped uploads. The API also counts the bytes it reads.
	@audio path /asks/upload
	request_body @audio {
		max_size 1MB
	}
	@image path /samples/live/upload
	request_body @image {
		max_size 3MB
	}
	@rest not path /asks/upload /samples/live/upload
	request_body @rest {
		max_size 16KB
	}
	reverse_proxy api:8000
}
