{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Nivetha200111/Diocle/contracts/run.schema.json",
  "title": "Run",
  "description": "v0.8 (adds visitor) (v0.2 added efficiency, v0.3 memory, v0.4 status and stage events, v0.5 breaker agent and swarm, v0.6 certificationSeed and error, v0.7 the public re-verify response). One converter run as served by services/api GET /runs/{id}: provenance, the agent trace, verification before and after, model usage, and the Java diff.",
  "type": "object",
  "required": [
    "id",
    "program",
    "command",
    "certified",
    "javaOrigin",
    "events",
    "usage"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "program": {
      "type": "string"
    },
    "command": {
      "type": "string",
      "enum": [
        "repair",
        "run"
      ]
    },
    "createdAt": {
      "type": "string",
      "description": "ISO 8601, from the run directory name"
    },
    "certified": {
      "type": "boolean"
    },
    "certificationSeed": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Seed of the held-out inputs that certified the run"
    },
    "error": {
      "type": [
        "string",
        "null"
      ],
      "description": "Set when the converter crashed; the run is then not certified"
    },
    "status": {
      "type": "string",
      "enum": [
        "running",
        "certified",
        "not-certified"
      ],
      "description": "running while the converter is still working; events grow as it goes"
    },
    "javaOrigin": {
      "type": "string",
      "description": "Where the Java started: a copied conversion or a model translation"
    },
    "rounds": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "events": {
      "type": "array",
      "description": "Agent trace: agent-step, certification and budget events, in order.",
      "items": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "agent-step",
              "certification",
              "budget",
              "memory",
              "stage",
              "breaker"
            ]
          },
          "round": {
            "type": "integer"
          },
          "step": {
            "type": "integer"
          },
          "tool": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "argsSummary": {
            "type": "object"
          },
          "resultSummary": {
            "type": "string"
          },
          "passed": {
            "type": "boolean"
          },
          "result": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "stage": {
            "type": "string",
            "enum": [
              "translating",
              "verifying",
              "repairing",
              "certifying",
              "attacking",
              "done"
            ]
          },
          "tried": {
            "type": "integer"
          },
          "broke": {
            "type": "integer"
          }
        }
      }
    },
    "before": {
      "$ref": "#/$defs/verification",
      "description": "Verification of the starting Java (null if not recorded)"
    },
    "after": {
      "$ref": "#/$defs/verification",
      "description": "Certification on held-out inputs (null if none)"
    },
    "usage": {
      "type": "object",
      "required": [
        "calls",
        "inputTokens",
        "outputTokens"
      ],
      "properties": {
        "calls": {
          "type": "integer"
        },
        "inputTokens": {
          "type": "integer"
        },
        "cachedInputTokens": {
          "type": "integer"
        },
        "outputTokens": {
          "type": "integer"
        },
        "estimatedCostUsd": {
          "type": [
            "number",
            "null"
          ]
        },
        "modelCalls": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "javaDiff": {
      "type": [
        "string",
        "null"
      ],
      "description": "Unified diff from the starting Java to the final Java"
    },
    "efficiency": {
      "$ref": "#/$defs/efficiency"
    },
    "breaker": {
      "type": [
        "object",
        "null"
      ],
      "description": "Breaker agent results after certification: designed inputs tried, how many broke the Java, whether the repair fixed them",
      "properties": {
        "rounds": {
          "type": "integer"
        },
        "tried": {
          "type": "integer"
        },
        "broke": {
          "type": "integer"
        },
        "fixed": {
          "type": "boolean"
        },
        "repairCycles": {
          "type": "integer"
        },
        "recheckBroke": {
          "type": "integer"
        },
        "counterexamples": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "swarm": {
      "type": "boolean",
      "description": "Run picked up lessons certified by parallel agents mid-run"
    },
    "memory": {
      "type": [
        "object",
        "null"
      ],
      "description": "Fix memory: lessons read at the start, and lessons stored after held-out certification passed. Null for runs saved before memory existed.",
      "required": [
        "enabled",
        "used",
        "learned",
        "lessons"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "used": {
          "type": "integer"
        },
        "learned": {
          "type": "integer",
          "description": "Lessons new to memory from this run"
        },
        "lessons": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "pattern",
              "cobol",
              "java"
            ],
            "properties": {
              "pattern": {
                "type": "string"
              },
              "cobol": {
                "type": "string"
              },
              "java": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "visitor": {
      "type": "boolean",
      "description": "From a visitor's import of a repository Diocle does not control: shown as the sandbox reported it, not offered for public re-verification"
    }
  },
  "$defs": {
    "reverify": {
      "type": "object",
      "description": "POST /runs/{id}/reverify: the run's certified Java and the original COBOL re-run on fresh random inputs. No model calls.",
      "required": [
        "runId",
        "seed",
        "passed",
        "total",
        "failed",
        "stdoutMatch",
        "exitCodeMatch",
        "seconds"
      ],
      "properties": {
        "runId": {
          "type": "string"
        },
        "seed": {
          "type": "integer"
        },
        "passed": {
          "type": "integer"
        },
        "total": {
          "type": "integer"
        },
        "failed": {
          "type": "integer"
        },
        "stdoutMatch": {
          "type": "boolean"
        },
        "exitCodeMatch": {
          "type": "boolean"
        },
        "allMatch": {
          "type": "boolean"
        },
        "firstMismatch": {
          "type": [
            "string",
            "null"
          ]
        },
        "seconds": {
          "type": "number"
        }
      }
    },
    "efficiency": {
      "type": "object",
      "description": "How efficiently the agent reached its result. Derived from usage and events; costs are estimates from list prices.",
      "required": [
        "cobolLines",
        "modelCalls",
        "toolSteps",
        "patchesApplied",
        "cacheHitRate",
        "totalTokens",
        "modelTimeMs",
        "estimatedCostUsd",
        "costPer1kLinesUsd"
      ],
      "properties": {
        "cobolLines": {
          "type": "integer",
          "description": "Non-blank, non-comment lines of the program and its copybooks"
        },
        "modelCalls": {
          "type": "integer"
        },
        "toolSteps": {
          "type": "integer"
        },
        "patchesApplied": {
          "type": "integer"
        },
        "cacheHitRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "cachedInputTokens / inputTokens"
        },
        "totalTokens": {
          "type": "integer",
          "description": "input + output tokens"
        },
        "modelTimeMs": {
          "type": "integer",
          "description": "Sum of model call latencies"
        },
        "estimatedCostUsd": {
          "type": [
            "number",
            "null"
          ]
        },
        "costPer1kLinesUsd": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "verification": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "total",
        "passed",
        "failed",
        "stdoutMatch",
        "failingExamples"
      ],
      "properties": {
        "total": {
          "type": "integer"
        },
        "passed": {
          "type": "integer"
        },
        "failed": {
          "type": "integer"
        },
        "stdoutMatch": {
          "type": "boolean"
        },
        "failingExamples": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "inputId",
              "diff"
            ],
            "properties": {
              "inputId": {
                "type": "string"
              },
              "inputSource": {
                "type": "string"
              },
              "diff": {
                "type": "string"
              },
              "fieldDiffs": {
                "type": "array"
              }
            }
          }
        }
      }
    }
  }
}
