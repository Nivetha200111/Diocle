{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Nivetha200111/Diocle/contracts/verification-report.schema.json",
  "title": "VerificationReport",
  "description": "Output of services/verifier (GnuCOBOL differential testing). v0.3: per-case input, input source and field-level diffs; run metadata; v0.3 adds exitCodeMatch (RETURN-CODE) and the pinned clock.",
  "type": "object",
  "required": [
    "version",
    "results",
    "summary"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "program",
          "inputId",
          "match"
        ],
        "properties": {
          "program": {
            "type": "string"
          },
          "inputId": {
            "type": "string"
          },
          "match": {
            "type": "boolean"
          },
          "originalOutput": {
            "type": "string"
          },
          "convertedOutput": {
            "type": "string"
          },
          "diff": {
            "type": "string"
          },
          "input": {
            "type": "string",
            "description": "The input record used for this case, as fed to both programs."
          },
          "inputSource": {
            "type": "string",
            "enum": [
              "boundary",
              "random",
              "model",
              "fixture"
            ],
            "description": "How the input was generated."
          },
          "fieldDiffs": {
            "type": "array",
            "description": "Fields whose values differ between original and converted output.",
            "items": {
              "type": "object",
              "required": [
                "field",
                "original",
                "converted"
              ],
              "properties": {
                "field": {
                  "type": "string"
                },
                "original": {
                  "type": "string"
                },
                "converted": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "total",
        "passed",
        "failed"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "sonarqube": {
      "type": "object",
      "description": "Optional SonarQube Community results.",
      "additionalProperties": true
    },
    "runs": {
      "type": "object",
      "description": "How each side was built and run.",
      "properties": {
        "original": {
          "type": "object",
          "required": [
            "compiled",
            "exitCode"
          ],
          "properties": {
            "compiled": {
              "type": "boolean"
            },
            "exitCode": {
              "type": [
                "integer",
                "null"
              ]
            },
            "stdout": {
              "type": "string"
            },
            "stderr": {
              "type": "string"
            }
          }
        },
        "converted": {
          "type": "object",
          "required": [
            "compiled",
            "exitCode"
          ],
          "properties": {
            "compiled": {
              "type": "boolean"
            },
            "exitCode": {
              "type": [
                "integer",
                "null"
              ]
            },
            "stdout": {
              "type": "string"
            },
            "stderr": {
              "type": "string"
            }
          }
        },
        "stdoutMatch": {
          "type": "boolean"
        },
        "exitCodeMatch": {
          "type": "boolean",
          "description": "Both programs ended with the same exit code (COBOL RETURN-CODE)."
        },
        "clock": {
          "type": [
            "string",
            "null"
          ],
          "description": "Date and time both programs saw (COB_CURRENT_DATE / DIOCLE_CLOCK, UTC)."
        }
      }
    }
  }
}
