{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Nivetha200111/Diocle/contracts/verification-report.schema.json",
  "title": "VerificationReport",
  "description": "Output of services/verifier (GnuCOBOL differential testing). v0.3: per-case input, input source and field-level diffs; run metadata; v0.3 adds exitCodeMatch (RETURN-CODE), the pinned clock and the collating sequence; v0.4 adds golden-file replay against captured mainframe output; v0.5 adds multi-file programs (results per output DD). v0.6: outputs compared as a sequence by position and byte for byte (inputSource 'output', fieldDiffs note).",
  "type": "object",
  "required": [
    "version",
    "results",
    "summary"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "program",
          "inputId",
          "match"
        ],
        "properties": {
          "program": {
            "type": "string"
          },
          "inputId": {
            "type": "string"
          },
          "match": {
            "type": "boolean"
          },
          "originalOutput": {
            "type": "string"
          },
          "convertedOutput": {
            "type": "string"
          },
          "diff": {
            "type": "string"
          },
          "input": {
            "type": "string",
            "description": "The input record used for this case, as fed to both programs."
          },
          "inputSource": {
            "type": "string",
            "enum": [
              "boundary",
              "random",
              "model",
              "fixture",
              "golden",
              "corpus",
              "files",
              "output"
            ],
            "description": "How the input was generated. 'files': an output record of a multi-file run, whose inputs are whole generated files. 'output': a record of a program whose outputs do not map one to one to its inputs (aggregation, fan-out); compared by position in the output."
          },
          "fieldDiffs": {
            "type": "array",
            "description": "Fields whose values differ between original and converted output.",
            "items": {
              "type": "object",
              "required": [
                "field",
                "original",
                "converted"
              ],
              "properties": {
                "field": {
                  "type": "string"
                },
                "original": {
                  "type": "string"
                },
                "converted": {
                  "type": "string"
                },
                "note": {
                  "type": "string",
                  "description": "e.g. 'same value, different bytes' (+00 vs -00): records must match byte for byte"
                }
              }
            }
          },
          "oracle": {
            "type": "string",
            "enum": [
              "gnucobol",
              "mainframe"
            ],
            "description": "What the converted output was compared with: GnuCOBOL's output, or a captured mainframe output (golden)."
          },
          "outputDd": {
            "type": "string",
            "description": "Output file (DD name) this record belongs to, for programs with several output files."
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "total",
        "passed",
        "failed"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "sonarqube": {
      "type": "object",
      "description": "Optional SonarQube Community results.",
      "additionalProperties": true
    },
    "runs": {
      "type": "object",
      "description": "How each side was built and run.",
      "properties": {
        "original": {
          "type": "object",
          "required": [
            "compiled",
            "exitCode"
          ],
          "properties": {
            "compiled": {
              "type": "boolean"
            },
            "exitCode": {
              "type": [
                "integer",
                "null"
              ]
            },
            "stdout": {
              "type": "string"
            },
            "stderr": {
              "type": "string"
            }
          }
        },
        "converted": {
          "type": "object",
          "required": [
            "compiled",
            "exitCode"
          ],
          "properties": {
            "compiled": {
              "type": "boolean"
            },
            "exitCode": {
              "type": [
                "integer",
                "null"
              ]
            },
            "stdout": {
              "type": "string"
            },
            "stderr": {
              "type": "string"
            }
          }
        },
        "stdoutMatch": {
          "type": "boolean"
        },
        "exitCodeMatch": {
          "type": "boolean",
          "description": "Both programs ended with the same exit code (COBOL RETURN-CODE)."
        },
        "clock": {
          "type": [
            "string",
            "null"
          ],
          "description": "Date and time both programs saw (COB_CURRENT_DATE / DIOCLE_CLOCK, UTC)."
        },
        "collation": {
          "type": "string",
          "enum": [
            "ascii",
            "ebcdic"
          ],
          "description": "Collating sequence for alphanumeric comparisons and sorts (ebcdic = mainframe order)."
        },
        "golden": {
          "type": [
            "object",
            "null"
          ],
          "description": "Golden-file replay: captured mainframe inputs and outputs, converted from EBCDIC field by field.",
          "properties": {
            "cases": {
              "type": "integer"
            },
            "codepage": {
              "type": "string"
            },
            "source": {
              "type": "string"
            },
            "oracleAgreement": {
              "type": "integer",
              "description": "Golden cases where GnuCOBOL's output equals the mainframe's"
            },
            "oracleDisagreements": {
              "type": "array",
              "items": {
                "type": "object"
              },
              "description": "Where GnuCOBOL differs from the mainframe; the mainframe is the authority"
            },
            "aligned": {
              "type": "boolean",
              "description": "False when captured inputs and outputs do not pair one to one; every golden case then fails"
            }
          }
        },
        "files": {
          "type": [
            "object",
            "null"
          ],
          "description": "Multi-file runs: records per input DD, and records each side wrote per output DD.",
          "properties": {
            "inputs": {
              "type": "object"
            },
            "outputs": {
              "type": "object"
            }
          }
        }
      }
    }
  }
}
