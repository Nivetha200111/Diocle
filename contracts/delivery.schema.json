{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Nivetha200111/Diocle/contracts/delivery.schema.json",
  "title": "Delivery",
  "description": "v0.3 (target optional: a visitor's import keeps its results on the site; adds public and per-program reason). A migration from a legacy GitHub repository to a pull request on a target repository, as served by services/api GET /deliveries/{id}. Updated while it runs.",
  "type": "object",
  "required": [
    "id",
    "legacy",
    "target",
    "stage",
    "programs",
    "startedAt"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "legacy": {
      "type": "object",
      "required": [
        "repository"
      ],
      "properties": {
        "repository": {
          "type": "string"
        },
        "commit": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "target": {
      "type": [
        "string",
        "null"
      ],
      "description": "Repository that receives the pull request; null for an import whose results stay on the site"
    },
    "stage": {
      "type": "string",
      "enum": [
        "analyzing",
        "converting",
        "delivering",
        "done",
        "failed"
      ]
    },
    "startedAt": {
      "type": "string"
    },
    "finishedAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "precheck": {
      "type": [
        "object",
        "null"
      ],
      "description": "Visitor imports only: the compile-only check of the original programs (contracts/compile-check.schema.json). checked = programs asked; stopped = why the check ended early (sandbox busy or unreachable, time or count bound) or null; notes = diagnostics for the operator (never secrets).",
      "properties": {
        "checked": {"type": "integer"},
        "stopped": {"type": ["string", "null"]},
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "programs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "converting",
              "certified",
              "not-certified",
              "skipped"
            ]
          },
          "runId": {
            "type": [
              "string",
              "null"
            ]
          },
          "run": {
            "type": [
              "object",
              "null"
            ],
            "description": "Live summary of the converter run: status, stage, recent events, efficiency so far"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ],
            "description": "Why a program was skipped (for example: over the line limit for visitor imports)"
          }
        }
      }
    },
    "pullRequest": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "url": {
          "type": "string"
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "state"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "state": {
                "type": "string"
              },
              "link": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "public": {
      "type": "boolean",
      "description": "Started by a visitor without the admin passcode (sandboxed, capped, never opens a pull request)"
    }
  },
  "$defs": {
    "request": {
      "type": "object",
      "description": "POST /deliveries body. With the admin passcode: any allowed target, pull request opened. Without it (a visitor): legacy only, any public GitHub repository, sandboxed and capped; results stay on the site.",
      "required": [
        "legacy"
      ],
      "properties": {
        "legacy": {
          "type": "string",
          "description": "https://github.com/<owner>/<repo> to migrate"
        },
        "target": {
          "type": [
            "string",
            "null"
          ],
          "description": "https://github.com/<owner>/<repo> that receives the pull request (admin only)"
        },
        "parallel": {
          "type": "boolean",
          "default": false
        },
        "breaker": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    }
  }
}
