{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Nivetha200111/Diocle/contracts/certificate.schema.json",
  "title": "EquivalenceCertificate",
  "description": "v0.1. Written next to each converted program in a delivery pull request (programs/<PROGRAM>/certificate.json). It pins the legacy source and the verifier so CI can re-run the proof independently on fresh inputs.",
  "type": "object",
  "required": ["version", "program", "legacy", "java", "verification", "agent", "issuedAt"],
  "properties": {
    "version": { "type": "string" },
    "program": { "type": "string" },
    "legacy": {
      "type": "object",
      "required": ["repository", "commit", "path", "copybooks"],
      "properties": {
        "repository": { "type": "string", "description": "https://github.com/<owner>/<repo>" },
        "commit": { "type": "string" },
        "path": { "type": "string", "description": "COBOL source path in the legacy repository" },
        "copybooks": { "type": "array", "items": { "type": "string", "description": "Copybook paths in the legacy repository" } },
        "modules": { "type": "array", "items": { "type": "string" }, "description": "Paths of CALLed programs compiled with it" },
        "job": { "type": ["string", "null"] }
      }
    },
    "java": {
      "type": "object",
      "required": ["mainClass", "files"],
      "properties": {
        "mainClass": { "type": "string" },
        "files": { "type": "array", "items": { "type": "string" } }
      }
    },
    "verification": {
      "type": "object",
      "description": "Diocle's held-out certification. CI repeats it with its own seed.",
      "required": ["passed", "total", "stdoutMatch", "seed", "verifier"],
      "properties": {
        "passed": { "type": "integer" },
        "total": { "type": "integer" },
        "stdoutMatch": { "type": "boolean" },
        "seed": { "type": "integer" },
        "verifier": {
          "type": "object",
          "required": ["repository", "commit"],
          "properties": {
            "repository": { "type": "string" },
            "commit": { "type": "string", "description": "Diocle commit whose services/verifier produced the result" },
            "gnucobol": { "type": "string" }
          }
        }
      }
    },
    "agent": {
      "type": "object",
      "required": ["runId", "model", "mode", "rounds", "modelCalls", "totalTokens", "estimatedCostUsd"],
      "properties": {
        "runId": { "type": "string" },
        "model": { "type": ["string", "null"] },
        "mode": { "type": "string", "enum": ["translate", "repair"] },
        "rounds": { "type": "integer" },
        "modelCalls": { "type": "integer" },
        "totalTokens": { "type": "integer" },
        "estimatedCostUsd": { "type": ["number", "null"] },
        "memoryLessonsUsed": { "type": "integer" }
      }
    },
    "issuedAt": { "type": "string", "description": "ISO 8601" }
  }
}
