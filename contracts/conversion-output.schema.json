{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Nivetha200111/Diocle/contracts/conversion-output.schema.json",
  "title": "ConversionOutput",
  "description": "DRAFT placeholder. Output of services/converter.",
  "type": "object",
  "required": ["version", "sqlSchemas", "javaServices", "tests"],
  "properties": {
    "version": { "type": "string" },
    "model": { "type": "string", "description": "Model used for conversion (Muse Spark via Meta Model API)." },
    "sqlSchemas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["copybook", "path"],
        "properties": {
          "copybook": { "type": "string" },
          "path": { "type": "string" }
        }
      }
    },
    "javaServices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["program", "path"],
        "properties": {
          "program": { "type": "string" },
          "path": { "type": "string" }
        }
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["program", "path"],
        "properties": {
          "program": { "type": "string" },
          "path": { "type": "string" }
        }
      }
    },
    "jobPipelines": {
      "type": "array",
      "description": "Additive (v0.5). Whole-JCL-job conversions: one generated Java driver per job, running each step (SORT or COBOL) in job order through the same DD-to-file wiring as the original JCL. See services/converter/diocle_converter/pipeline.py.",
      "items": {
        "type": "object",
        "required": ["job", "path", "driverClass", "steps"],
        "properties": {
          "job": { "type": "string", "description": "The job's //jobname JOB card." },
          "path": { "type": "string", "description": "Directory containing the generated .java files for this job." },
          "driverClass": { "type": "string", "description": "Main class that runs every step in order via ProcessBuilder." },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["step", "kind", "mainClass", "origin", "dd"],
              "properties": {
                "step": { "type": "string" },
                "kind": { "type": "string", "enum": ["cobol", "sort"] },
                "mainClass": { "type": "string" },
                "origin": {
                  "type": "string",
                  "enum": ["model", "deterministic"],
                  "description": "model: translated by the Meta model (translate.py). deterministic: generated by sortgen.py with zero model calls."
                },
                "dd": {
                  "type": "object",
                  "description": "DD name -> file path this step's java -cp run binds via DD_<name> environment variables.",
                  "additionalProperties": { "type": "string" }
                }
              }
            }
          }
        }
      }
    }
  }
}
