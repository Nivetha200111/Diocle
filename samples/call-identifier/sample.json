{
  "name": "call-identifier",
  "description": "SYNTHETIC. Quillmark Trust & Savings (fictional): payments posted with a fee module reached through CALL identifier that only ever holds one literal.",
  "program": "FEEPOST",
  "source": "src/FEEPOST.cbl",
  "modules": [
    "src/FEECALC.cbl"
  ],
  "collation": "ebcdic",
  "copybookDir": "copybooks",
  "dd": {
