# Copy to .env and fill in. Never commit .env.

# Hosted mode: Muse Spark via the Meta Model API (OpenAI-compatible Chat Completions).
# muse-spark-1.3-contributor: $0.10 in / $0.20 out per 1M tokens; Meta may use requests to improve products.
#   Fine for our synthetic, already-public samples. Use muse-spark-1.3 ($1.25 / $4.25) for anything private.
META_MODEL_API_KEY=
META_MODEL_BASE_URL=https://api.meta.ai/v1
META_MODEL_ID=muse-spark-1.3-contributor

# Private mode: Muse Spark Open (open weights) via a partner host. Defaults are Fireworks
# (serverless, $1.25 in / $4.25 out per 1M tokens, default reasoning effort is xhigh, so keep MODEL_REASONING_EFFORT set).
# Baseten instead: OPEN_MODEL_BASE_URL=https://inference.baseten.co/v1, OPEN_MODEL_ID=meta-models/muse-spark-open-1026
OPEN_MODEL_API_KEY=
OPEN_MODEL_BASE_URL=https://api.fireworks.ai/inference/v1
OPEN_MODEL_ID=accounts/fireworks/models/muse-spark-open

# Optional escalation tiers (converter --tiers, hosted mode): when a certification round fails the repair agent moves up one
# tier; the breaker attacks with the highest. META_MODEL_ID above is tier 1. Same host and key. Hard caps below (rule 10).
# Prices per 1M tokens (in / cached / out): muse-spark-1.3 $1.25 / $0.15 / $4.25; muse-wonder-1.0 $4.00 / $0.20 / $20.00
# (Wonder per third-party coverage, unconfirmed on dev.meta.ai). Leave empty for no escalation.
MODEL_TIER_2_ID=
MODEL_TIER_3_ID=
MODEL_ESCALATION_MAX_CALLS=12
MODEL_ESCALATION_MAX_USD=0.50
# Which tier designs breaker attacks, and which tier repair resumes at after a break (default 2; 3 = Muse Wonder, dearer).
MODEL_TIER_BREAKER=2
MODEL_TIER_AFTER_BREAK=2

# Optional: a different host/model for the independent cross-check (--crosscheck). Defaults to the OPEN_MODEL_* above.
# CROSSCHECK_MODEL_API_KEY=
# CROSSCHECK_MODEL_BASE_URL=
# CROSSCHECK_MODEL_ID=
# CROSSCHECK_MAX_CALLS=2
# Guard agent (in progress): reviews each certified run's final Java against the COBOL with its own Meta model and
# key, and can revoke certification. Its deterministic policy runs on every run regardless. Leave empty for policy only.
# Muse Spark Open on Baseten (same price as Fireworks: $1.25 in / $0.15 cached / $4.25 out per 1M tokens).
GUARD_MODEL_API_KEY=
GUARD_MODEL_BASE_URL=https://inference.baseten.co/v1
GUARD_MODEL_ID=meta-models/muse-spark-open-1026
GUARD_REASONING_EFFORT=medium
# Hard cap (rule 10): model calls the guard may make per run
GUARD_MAX_CALLS=2

# Which backend the converter uses: hosted | private
MODEL_MODE=hosted

# Reasoning effort: low | medium | high | xhigh (Meta API also accepts none/minimal; Fireworks rejects none)
MODEL_REASONING_EFFORT=medium

# Hard caps (CLAUDE.md rule 10)
MODEL_MAX_CALLS_PER_RUN=60
MODEL_MAX_CALLS_PER_ROUND=20
MODEL_MAX_ROUNDS=3

# Optional: SonarQube Community quality gate (self-hosted)
SONAR_HOST_URL=
SONAR_TOKEN=
# Breaker agent caps (rule 10): attack rounds, then repair-and-re-attack cycles after a break
MODEL_MAX_ATTACK_ROUNDS=3
MODEL_MAX_BREAKER_CYCLES=1
# Delivery swarm caps: programs converted at once, and programs per delivery
DIOCLE_MAX_PARALLEL=4
DIOCLE_MAX_PROGRAMS=10
