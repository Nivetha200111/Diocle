# Copy to .env and fill in. Never commit .env.

# Hosted mode: Muse Spark via the Meta Model API
META_MODEL_API_KEY=
META_MODEL_BASE_URL=
META_MODEL_ID=

# Private mode: Muse Spark Open (open weights) via Baseten or Modal
OPEN_MODEL_API_KEY=
OPEN_MODEL_BASE_URL=
OPEN_MODEL_ID=meta-models/muse-spark-open-1026

# Which backend the converter uses: hosted | private
MODEL_MODE=hosted

# Optional: SonarQube Community quality gate (self-hosted)
SONAR_HOST_URL=
SONAR_TOKEN=
