        </mxCell>
        <mxCell id="v6" value="&lt;b&gt;Equivalence certificate&lt;/b&gt;&lt;br&gt;pass/fail on execution · inputs · rounds · quality gate · residual risks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="verifier">
