        </mxCell>
        <mxCell id="c2" value="&lt;b&gt;2B Paragraph translator&lt;/b&gt;&lt;br&gt;class map + var map + isolated paragraph → Java" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="converter">
          <mxGeometry x="15" y="115" width="390" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="&lt;b&gt;2C Repair agent&lt;/b&gt; (tool-using) · fixes diff mismatches AND SonarQube issues&lt;br&gt;&lt;i&gt;tools:&lt;/i&gt; compile_java · run_differential_test · get_quality_issues · lookup_field_layout · read_cobol_paragraph · read_java_method · patch_java · finish&lt;br&gt;&lt;i&gt;accept patch only if:&lt;/i&gt; compiles + outputs still match COBOL + issue gone · ≤20 calls/round · ≤3 rounds · cannot self-certify" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=2;fontSize=11;" vertex="1" parent="converter">
          <mxGeometry x="15" y="185" width="390" height="125" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="&lt;b&gt;Rule extractor&lt;/b&gt;&lt;br&gt;plain-English business rules" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="converter">
          <mxGeometry x="15" y="320" width="190" height="55" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="&lt;b&gt;Edge-case test designer&lt;/b&gt;&lt;br&gt;semantic inputs for verifier" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="converter">
          <mxGeometry x="215" y="320" width="190" height="55" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="&lt;b&gt;LLM-as-a-Judge&lt;/b&gt; (1–7, advisory only)&lt;br&gt;control-flow fidelity · idiomatic Java" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="converter">
          <mxGeometry x="15" y="390" width="390" height="60" as="geometry" />
        </mxCell>

        <!-- Layer 3: Verifier -->
        <mxCell id="verifier" value="Layer 3 · services/verifier · Docker: GnuCOBOL + JDK 21" style="swimlane;startSize=30;html=1;whiteSpace=wrap;rounded=1;arcSize=3;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="900" y="430" width="420" height="470" as="geometry" />
