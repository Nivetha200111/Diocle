          <mxGeometry x="15" y="390" width="390" height="60" as="geometry" />
        </mxCell>

        <!-- Bottom row -->
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Status: all components PLANNED (Oct 27 2026)&lt;br&gt;Solid arrows: contract hand-offs (contracts/*.schema.json)&lt;br&gt;&lt;font color=&quot;#9673a6&quot;&gt;Purple dashed: agent tool calls&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;Red dashed: tool results / diffs back to agent (≤3 rounds)&lt;/font&gt;&lt;br&gt;Samples: synthetic COBOL only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="950" width="380" height="125" as="geometry" />
