<mxfile host="app.diagrams.net" agent="Diocle docs">
  <diagram id="diocle-architecture" name="Architecture (planned)">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1360" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="&lt;b&gt;Diocle&lt;/b&gt; · COBOL → Java modernization with verified equivalence (PLANNED architecture, not yet implemented)" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1280" height="30" as="geometry" />
        </mxCell>

        <!-- Layer 4: Portal -->
        <mxCell id="portal" value="Layer 4 · apps/web · Modernization Portal (Next.js)" style="swimlane;startSize=30;html=1;whiteSpace=wrap;rounded=1;arcSize=4;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="1280" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p1" value="&lt;b&gt;Split editor&lt;/b&gt;&lt;br&gt;COBOL ⇄ copybook vars ⇄ Java" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="portal">
          <mxGeometry x="15" y="45" width="195" height="65" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="&lt;b&gt;Topology graph&lt;/b&gt;&lt;br&gt;CALL · COPY · SQL · CICS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="portal">
          <mxGeometry x="225" y="45" width="195" height="65" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="&lt;b&gt;Live run timeline&lt;/b&gt;&lt;br&gt;SSE run-events" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="portal">
          <mxGeometry x="435" y="45" width="195" height="65" as="geometry" />
        </mxCell>
        <mxCell id="p4" value="&lt;b&gt;Agent trace + repair diffs&lt;/b&gt;&lt;br&gt;tool calls · rationale · round 1 → N" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="portal">
          <mxGeometry x="645" y="45" width="195" height="65" as="geometry" />
        </mxCell>
        <mxCell id="p5" value="&lt;b&gt;Model call log&lt;/b&gt;&lt;br&gt;role · mode · round · tokens · latency" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="portal">
          <mxGeometry x="855" y="45" width="195" height="65" as="geometry" />
        </mxCell>
        <mxCell id="p6" value="&lt;b&gt;Equivalence scorecard&lt;/b&gt;&lt;br&gt;pass rate · var coverage · judge · certificate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="portal">
          <mxGeometry x="1065" y="45" width="195" height="65" as="geometry" />
        </mxCell>

        <!-- API orchestrator -->
        <mxCell id="api" value="services/api · FastAPI orchestrator · POST /runs · GET /runs/{id} · GET /runs/{id}/events (SSE)" style="swimlane;startSize=30;html=1;whiteSpace=wrap;rounded=1;arcSize=4;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="240" width="1280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="api-sm" value="&lt;b&gt;Run state machine:&lt;/b&gt;  UPLOADED → ANALYZING → DESIGNING → CONVERTING → VERIFYING ⇄ REPAIRING (≤3 rounds) → CERTIFIED | NEEDS_REVIEW" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="api">
          <mxGeometry x="15" y="40" width="1250" height="55" as="geometry" />
        </mxCell>

        <!-- Layer 1: Analyzer -->
        <mxCell id="analyzer" value="Layer 1 · services/analyzer · DETERMINISTIC (no LLM)" style="swimlane;startSize=30;html=1;whiteSpace=wrap;rounded=1;arcSize=3;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="430" width="380" height="470" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="&lt;b&gt;ProLeap COBOL parser&lt;/b&gt; (ANTLR4)&lt;br&gt;Java CLI → AST + ASG as JSON" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="analyzer">
          <mxGeometry x="15" y="45" width="350" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="&lt;b&gt;Topology graph&lt;/b&gt;&lt;br&gt;CALL · COPY · EXEC SQL · EXEC CICS (graphed, not executed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="analyzer">
          <mxGeometry x="15" y="115" width="350" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="&lt;b&gt;Data layout normalizer&lt;/b&gt;&lt;br&gt;COMP-3 → BigDecimal (HALF_UP)&lt;br&gt;REDEFINES → byte-buffer view · OCCURS → 1-based array" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="analyzer">
          <mxGeometry x="15" y="185" width="350" height="75" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="&lt;b&gt;Risk rules&lt;/b&gt;&lt;br&gt;money COMPUTE · ROUNDED · GO TO · REDEFINES" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="analyzer">
          <mxGeometry x="15" y="270" width="350" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a5" value="Emits: analysis-report + layout dictionary" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=2;" vertex="1" parent="analyzer">
          <mxGeometry x="15" y="410" width="350" height="40" as="geometry" />
        </mxCell>

        <!-- Layer 2: Converter -->
        <mxCell id="converter" value="Layer 2 · services/converter · META MODELS ONLY" style="swimlane;startSize=30;html=1;whiteSpace=wrap;rounded=1;arcSize=3;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="450" y="430" width="420" height="470" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="&lt;b&gt;2A Class Designer&lt;/b&gt;&lt;br&gt;packages · DTOs · skeletons · variable map" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="converter">
